<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>FiapCloudGames.BuildingBlocks</PackageId>
    <Description>Componentes técnicos compartilhados entre os serviços do FIAP Cloud Games.</Description>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>FIAP Cloud Games</Authors>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/MarinsPedro/fcg-dotnet-building-blocks</RepositoryUrl>
    <PackageTags>aspnetcore;building-blocks;authentication;problem-details</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FiapCloudGames.BuildingBlocks.Tests" />
  </ItemGroup>

</Project>
